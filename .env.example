# Rats Overlay — copy this to .env and fill in whatever you want to enable.
# Every trigger is optional. If you don't set anything below, the REST API
# (POST /api/fire) still works — you can wire it up to anything that can make
# an HTTP request.

# ─── Server ports ───
# The HTTP server (overlay + API) and the WebSocket server (push to overlay).
# Defaults are fine unless something else is using these ports.
PORT=3080
WS_PORT=3082

# ─── Rat behavior ───
# Count defaults. Chat !rats with no number uses DEFAULT_COUNT, and everything
# is capped at MAX_COUNT (100 is a reasonable browser limit — higher will lag OBS).
DEFAULT_COUNT=10
MAX_COUNT=100

# ─── TRIGGER 1: Twitch chat command ───
# Fills in if you want anyone in chat to be able to type !rats (or !rats 15)
# and drop rats on screen. Per-user cooldown prevents spam.
# Leave the token blank to disable chat triggers entirely.
#
# To get TWITCH_TOKEN:
#   1. Go to https://twitchtokengenerator.com/
#   2. Click "Custom Scope Token"
#   3. Check: chat:read and chat:edit
#   4. Log in as your bot account (or your own account)
#   5. Copy the ACCESS TOKEN and paste it below WITH the "oauth:" prefix
TWITCH_USERNAME=
TWITCH_TOKEN=oauth:
TWITCH_CHANNEL=
CHAT_COMMAND_ENABLED=true
CHAT_COMMAND=!rats
CHAT_COMMAND_COOLDOWN_MS=15000

# ─── TRIGGER 2: Twitch channel point reward ───
# If you want rats to fire when a viewer redeems a custom channel point reward,
# paste the reward's UUID here. Find it by creating the reward in your Twitch
# dashboard, then looking at the channel points redemption log — the reward ID
# shows up in the URL or in the tmi.js chat tag on the redemption message.
#
# Requires TWITCH_TOKEN above (channel point redemptions come through chat tags).
# The viewer can type a number in their redemption message to set the count,
# e.g. "15" — otherwise a random number is used.
CHANNEL_POINT_REWARD_ID=

# ─── TRIGGER 3: REST API (always on) ───
# No configuration needed — just POST to /api/fire or GET /fire?count=X.
# Use this to wire up Streamer.bot, Streamlabs actions, dashboard buttons,
# your own bot, or any service that can make an HTTP request.
#
# Examples:
#   curl -X POST http://localhost:3080/api/fire -H "Content-Type: application/json" -d '{"count":15,"user":"CoolViewer"}'
#   curl "http://localhost:3080/fire?count=15&user=CoolViewer"
